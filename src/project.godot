[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/bounce_velocity_threshold=0.891
3d/default_gravity=9.734000000000002

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
viewport/hdr_2d=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=1
environment/defaults/default_clear_color=Color(0.43519226, 0.4351923, 0.43519217, 1)
anti_aliasing/quality/screen_space_aa=1

[xr]

shaders/enabled=true
