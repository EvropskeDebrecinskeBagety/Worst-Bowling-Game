;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=2

[application]

config/name="Worst Bowling Game"
config/description="Worst Bowling Game"
config/version="2026.09.1.4"
config/tags=PackedStringArray("game")
run/main_scene="uid://dq1hgsvlyespb"
run/enable_alt_space_menu=true
config/use_hidden_project_data_directory=false
config/use_custom_user_dir=true
config/custom_user_dir_name="E.D.B./Worst Bowling Game/maingame"
config/disable_project_settings_override=true
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=30
boot_splash/bg_color=Color(0.06469657, 0.06469652, 0.0646965, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://6m0lhtkkw3el"
config/icon="uid://eibryjj0vf0v"
boot_splash/minimum_display_time=1562

[debug]

settings/crash_handler/message="Please include this when reporting the bug to the project developer. http://github.com/filik19/worst-bowling-game"
file_logging/log_path="user://logs/wbg.log"
file_logging/max_log_files=11

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

